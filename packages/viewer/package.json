{
  "name": "@bomboard/viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @bomboard/parsers build",
    "pretypecheck": "pnpm --filter @bomboard/parsers build",
    "build": "tsc -p tsconfig.json && cp src/package-rules.json dist/package-rules.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bomboard/parsers": "workspace:*",
    "pixi.js": "^8.18.1"
  }
}
