{
  "name": "@bomboard/desktop-electron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 concurrently -k -n tsc,electron -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"wait-on dist/main.js tcp:127.0.0.1:5173 && electronmon dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "build": {
    "appId": "com.donnel666.bomboard",
    "productName": "BOMBoard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "BOMBoard-electron-setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "BOMBoard-electron-portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "donnel666",
        "repo": "BOMBoard"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.3",
    "wait-on": "^9.0.3"
  }
}
