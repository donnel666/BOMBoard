{
  "name": "bomboard",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @bomboard/web dev",
    "dev:desktop": "pnpm dev:desktop:electron",
    "dev:desktop:electron": "concurrently -k -n web,electron -c cyan,yellow \"pnpm dev:web\" \"pnpm --filter @bomboard/desktop-electron dev\"",
    "dev:desktop:tauri": "pnpm --filter @bomboard/desktop-tauri dev",
    "build:footprints": "node scripts/build-footprint-library.mjs",
    "scan:unmatched": "pnpm --filter @bomboard/runtime-web build && node scripts/scan-unmatched-footprints.mjs",
    "release:version": "node scripts/set-release-version.mjs",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
